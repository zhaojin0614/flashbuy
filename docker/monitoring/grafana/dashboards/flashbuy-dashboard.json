{
  "title": "FlashBuy 监控",
  "uid": "flashbuy-main",
  "tags": ["flashbuy"],
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP 请求速率（次/秒，按 URI）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP P95 延迟（秒）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx 错误率",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 0.001)" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 堆内存（字节）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (id)" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HikariCP 连接池",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active" },
        { "refId": "B", "expr": "hikaricp_connections_pending" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "秒杀接口请求速率（/order/seckill）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/order/seckill/{id}\"}[1m]))" }
      ]
    }
  ]
}
